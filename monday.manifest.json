{
  "app_name": "Monday Image Resizer",
  "description": "Automatically resize images in your Monday.com board. Simply click a button to resize images and save them to another column.",
  "version": "1.0.0",
  "icon": "https://raw.githubusercontent.com/mondaycom/monday-ui-react-core/master/src/assets/icons/file-dock.svg",
  "author": "Cameron Smith",
  "author_url": "www.artmonger.nyc",
  "permissions": [
    "boards:read",
    "boards:write",
    "files:read",
    "files:write",
    "context:read",
    "context:write"
  ],
  "features": {
    "boards": {
      "item_views": {
        "main": {
          "type": "item_view",
          "name": "Image Resizer",
          "url": "https://monday-img-app-aaca18d8516b.herokuapp.com/",
          "description": "Click a button to resize images. Requires two file columns - one for original images and one for resized images.",
          "height": 300,
          "required_scopes": [
            "boards:read",
            "boards:write",
            "files:read",
            "files:write",
            "context:read",
            "context:write"
          ],
          "supported_column_types": ["file"]
        }
      }
    }
  },
  "init_oauth": true,
  "oauth": {
    "client_id": "${CLIENT_ID}",
    "client_secret": "${CLIENT_SECRET}"
  }
} 